{
  "info": {
    "name": "Subscription Billing API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "http://localhost:5000/api/v1/auth/register", "host": ["http://localhost:5000"], "path": ["api", "v1", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "http://localhost:5000/api/v1/auth/login", "host": ["http://localhost:5000"], "path": ["api", "v1", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Plans",
      "item": [
        {
          "name": "Create Plan",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer YOUR_TOKEN_HERE" }
            ],
            "url": { "raw": "http://localhost:5000/api/v1/plans", "host": ["http://localhost:5000"], "path": ["api", "v1", "plans"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pro Plan\",\n  \"price\": 19.99,\n  \"billingCycle\": \"monthly\",\n  \"level\": 2,\n  \"features\": [\"Feature 1\", \"Feature 2\"]\n}"
            }
          }
        },
        {
          "name": "Get Plans",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "http://localhost:5000/api/v1/plans", "host": ["http://localhost:5000"], "path": ["api", "v1", "plans"] }
          }
        }
      ]
    },
    {
      "name": "Subscriptions",
      "item": [
        {
          "name": "Purchase/Upgrade Subscription",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer YOUR_TOKEN_HERE" }
            ],
            "url": { "raw": "http://localhost:5000/api/v1/subscriptions/purchase", "host": ["http://localhost:5000"], "path": ["api", "v1", "subscriptions", "purchase"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": \"PLAN_ID_HERE\"\n}"
            }
          }
        },
        {
          "name": "Get My Subscription",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer YOUR_TOKEN_HERE" }
            ],
            "url": { "raw": "http://localhost:5000/api/v1/subscriptions/my", "host": ["http://localhost:5000"], "path": ["api", "v1", "subscriptions", "my"] }
          }
        },
        {
          "name": "Cancel Subscription",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer YOUR_TOKEN_HERE" }
            ],
            "url": { "raw": "http://localhost:5000/api/v1/subscriptions/SUBSCRIPTION_ID_HERE/cancel", "host": ["http://localhost:5000"], "path": ["api", "v1", "subscriptions", "SUBSCRIPTION_ID_HERE", "cancel"] }
          }
        }
      ]
    },
    {
      "name": "Webhook",
      "item": [
        {
          "name": "Handle Webhook",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-webhook-secret", "value": "my_webhook_secret" }
            ],
            "url": { "raw": "http://localhost:5000/api/v1/webhook", "host": ["http://localhost:5000"], "path": ["api", "v1", "webhook"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subscriptionId\": \"SUBSCRIPTION_ID_HERE\",\n  \"event\": \"payment_success\"\n}"
            }
          }
        }
      ]
    }
  ]
}
